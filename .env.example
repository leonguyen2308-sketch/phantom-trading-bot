# Copy to .env and fill in. Never commit .env, never paste these anywhere else.
# (No comments on the same line as a value: everything after = is the value.)

# Jev, from TypeSafe (console.typesafe.ai). Leave JEV_MODEL blank for jev-latest.
TYPESAFE_API_KEY=
JEV_MODEL=

# Telegram alerts: make a bot with @BotFather, get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper trading
PAPER_START_USD=1000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5

# ---- Live trading. Only after `python -m phantom golive-check` passes. ----
# Use a NEW Phantom wallet made only for the bot, holding only what you can afford to lose.
LIVE_TRADING=no
PHANTOM_BOT_ADDRESS=
PHANTOM_BOT_PRIVATE_KEY=
# Jupiter API key (developers.jup.ag) and a Solana RPC URL (e.g. Helius or QuickNode).
JUPITER_API_KEY=
SOLANA_RPC_URL=

# ---- FOMO copy bot (./fomo.sh). The demo needs none of these. ----
# Paper and live: a Solana RPC (Helius free plan works) and a Jupiter API key (portal.jup.ag, free).
# Both are the same keys as above; SOLANA_WS_URL is only needed if your provider's websocket URL
# isn't the RPC URL with wss:// in front.
SOLANA_WS_URL=
# Where the top traders come from (the first one that is set and works wins):
# 1. Solana Tracker key (solanatracker.io, free plan): the most profitable Solana wallets of the last 7 days, up to 500.
SOLANATRACKER_API_KEY=
# 2. fomoapi.io key: FOMO's weekly top with wallets.
FOMOAPI_KEY=
# 3. Your own files: config/wallets.txt (one wallet address per line, best first) and config/traders.yaml.
FOMO_PAPER_START_USD=100
# Live: a NEW Phantom wallet only for this bot (not the BTC bot's, never your main one).
FOMO_LIVE=no
FOMO_BOT_ADDRESS=
FOMO_BOT_PRIVATE_KEY=

# ---- Memecoin Desk (./desk.sh). The demo needs none of these. ----
# Paper and live also need SOLANA_RPC_URL and JUPITER_API_KEY above.
# The Claude desk: an Anthropic API key from https://platform.claude.com (paid per use).
ANTHROPIC_API_KEY=
DESK_PAPER_START_USD=100
# Live: a NEW Phantom wallet only for this bot, never your main one.
DESK_LIVE=no
DESK_BOT_ADDRESS=
DESK_BOT_PRIVATE_KEY=

# ---- Grok bot (./grok.sh). The demo needs none of these. ----
# Paper and live also need SOLANA_RPC_URL and JUPITER_API_KEY above, and a top list (SOLANATRACKER_API_KEY,
# FOMOAPI_KEY or config/wallets.txt, as for the FOMO bot).
# xAI API key from https://console.x.ai (paid per use; the bot stops using Grok after grok.daily_budget_usd a day).
XAI_API_KEY=
GROK_PAPER_START_USD=115
# Live: a NEW Phantom wallet only for this bot, never your main one.
GROK_LIVE=no
GROK_BOT_ADDRESS=
GROK_BOT_PRIVATE_KEY=
