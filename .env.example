# Copy to .env and fill in. Never commit .env, never paste these anywhere else.
# (No comments on the same line as a value: everything after = is the value.)

# Jev, from TypeSafe (console.typesafe.ai). Leave JEV_MODEL blank for jev-latest.
TYPESAFE_API_KEY=
JEV_MODEL=

# Telegram alerts: make a bot with @BotFather, get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper trading
PAPER_START_USD=1000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5

# ---- Live trading. Only after `python -m phantom golive-check` passes. ----
# Use a NEW Phantom wallet made only for the bot, holding only what you can afford to lose.
LIVE_TRADING=no
PHANTOM_BOT_ADDRESS=
PHANTOM_BOT_PRIVATE_KEY=
# Jupiter API key (developers.jup.ag) and a Solana RPC URL (e.g. Helius or QuickNode).
JUPITER_API_KEY=
SOLANA_RPC_URL=

# ---- Pansol site and meme tracker (uv run python -m pansol) ----
# Phantom wallet addresses that can open /admin, separated by commas.
PANSOL_ADMIN_WALLETS=
# The address(es) people open, e.g. https://pansol.xyz,https://www.pansol.xyz (no path).
# Sign-in only works on these; with none set, only on localhost.
PANSOL_PUBLIC_URL=
# After launch: Pansol's token address, to show its live price on every tracker.
PANSOL_MINT=
# Where the user list is stored. Back this file up.
PANSOL_DB=state/pansol.db
