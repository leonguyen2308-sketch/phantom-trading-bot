# Copy to .env and fill in. Never commit .env, never paste these anywhere else.
# (No comments on the same line as a value: everything after = is the value.)

# Jev, from TypeSafe (console.typesafe.ai). Leave JEV_MODEL blank for jev-latest.
TYPESAFE_API_KEY=
JEV_MODEL=

# Telegram alerts: make a bot with @BotFather, get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper trading
PAPER_START_USD=1000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5

# ---- Live trading. Only after `python -m phantom golive-check` passes. ----
# Use a NEW Phantom wallet made only for the bot, holding only what you can afford to lose.
LIVE_TRADING=no
PHANTOM_BOT_ADDRESS=
PHANTOM_BOT_PRIVATE_KEY=
# Jupiter API key (developers.jup.ag) and a Solana RPC URL (e.g. Helius or QuickNode).
JUPITER_API_KEY=
SOLANA_RPC_URL=

# ---- Auto-post trades to X (optional) ----
# developer.x.com: create an app, set permissions to "Read and Write", then generate
# API Key/Secret and Access Token/Secret (regenerate the access token after changing permissions).
# Only BOUGHT / SOLD posts go out. Live trades post by default; set X_POST_PAPER=yes to post paper trades too.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_POST_PAPER=no
X_HASHTAGS=#BTC #Bitcoin

# ---- Trending coins to X: ./run.sh trending (uses the X keys above) ----
# Chain: solana, eth, base, bsc, arbitrum... Leave blank for all chains.
TRENDING_NETWORK=solana
TRENDING_EVERY_MIN=30
TRENDING_PER_RUN=1
TRENDING_MIN_VOLUME_USD=50000
TRENDING_HASHTAGS=#crypto #memecoin
